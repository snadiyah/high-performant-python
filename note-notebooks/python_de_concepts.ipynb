    "import tracemalloc, sys\n",
    "\n",
    "# ── tracemalloc: Track memory usage ──────────────────────────────────────────\n",
    "tracemalloc.start()\n",
    "\n",
    "# Memory-heavy: store everything in a list\n",
    "big_list = [x**2 for x in range(500_000)]\n",
    "snapshot1 = tracemalloc.take_snapshot()\n",
    "\n",
    "# Clear it\n",
    "del big_list\n",
    "\n",
    "# Memory-light: generator\n",
    "big_gen = (x**2 for x in range(500_000))\n",
    "snapshot2 = tracemalloc.take_snapshot()\n",
    "\n",
    "tracemalloc.stop()\n",
    "\n",
    "# Show top memory allocation lines\n",
    "stats1 = snapshot1.statistics('lineno')\n",
    "print(f\"Peak memory (list):      {stats1[0].size / 1024 / 1024:.2f} MB\")\n",
    "stats2 = snapshot2.statistics('lineno')\n",
    "print(f\"Peak memory (generator): {stats2[0].size / 1024:.2f} KB\")"
   ]
