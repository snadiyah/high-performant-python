   "source": [
    "import sys\n",
    "\n",
    "# ── __slots__: Reduce memory footprint of data record classes ─────────────────\n",
    "\n",
    "class OrderNormal:\n",
    "    def __init__(self, id, amount, currency):\n",
    "        self.id       = id\n",
    "        self.amount   = amount\n",
    "        self.currency = currency\n",
    "\n",
    "class OrderSlotted:\n",
    "    __slots__ = ['id', 'amount', 'currency']  # Pre-declare attributes\n",
    "    def __init__(self, id, amount, currency):\n",
    "        self.id       = id\n",
    "        self.amount   = amount\n",
    "        self.currency = currency\n",
    "\n",
    "normal  = OrderNormal(1, 99.99, 'USD')\n",
    "slotted = OrderSlotted(1, 99.99, 'USD')\n",
    "\n",
    "print(f\"Normal  object size: {sys.getsizeof(normal):>5} bytes (+ __dict__ overhead)\")\n",
    "print(f\"Slotted object size: {sys.getsizeof(slotted):>5} bytes\")\n",
    "print(f\"__dict__ size:       {sys.getsizeof(normal.__dict__):>5} bytes\")\n",
    "print(f\"\\nWith 10M records, __slots__ saves ~{(sys.getsizeof(normal.__dict__) * 10_000_000) / 1e9:.1f} GB\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "concept10-code5",
   "metadata": {},
