    "# ── Star unpacking in assignments ─────────────────────────────────────────────\n",
    "# Useful for processing file paths, partitions, or structured keys\n",
    "\n",
    "# Unpack S3 path parts\n",
    "path_parts = ['s3:', '', 'my-bucket', 'data', 'year=2024', 'month=01', 'file.parquet']\n",
    "protocol, _, bucket, *rest_path = path_parts\n",
    "print(f\"Protocol: {protocol}, Bucket: {bucket}, Path: {rest_path}\")\n",
    "\n",
    "# Unpack first and last from a sorted list\n",
    "timestamps = sorted(['2024-01-15', '2024-01-10', '2024-01-20', '2024-01-05'])\n",
    "earliest, *middle, latest = timestamps\n",
    "print(f\"Range: {earliest} → {latest}, Middle dates: {middle}\")\n",
    "\n",
    "# Swap variables (Python idiom, no temp variable needed)\n",
    "a, b = 10, 20\n",
    "a, b = b, a\n",
    "print(f\"After swap: a={a}, b={b}\")"
   ]
