   "source": [
    "from typing import TypedDict\n",
    "\n",
    "# ── TypedDict: for dict-shaped data (e.g., API responses, CSV rows) ───────────\n",
    "class SalesRecord(TypedDict):\n",
    "    order_id: str\n",
    "    customer_id: int\n",
    "    amount: float\n",
    "    currency: str\n",
    "\n",
    "# Used just like a dict — TypedDict only adds type hints\n",
    "record: SalesRecord = {\n",
    "    \"order_id\": \"ORD-001\",\n",
    "    \"customer_id\": 42,\n",
    "    \"amount\": 299.99,\n",
    "    \"currency\": \"USD\"\n",
    "}\n",
    "\n",
    "# Works with all dict operations\n",
    "print(f\"Order {record['order_id']}: {record['currency']} {record['amount']}\")\n",
    "\n",
    "# Great for annotating function signatures that process dict records\n",
    "def apply_exchange_rate(record: SalesRecord, rate: float) -> float:\n",
    "    return record['amount'] * rate\n",
    "\n",
    "print(f\"In EUR: {apply_exchange_rate(record, 0.92):.2f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "concept4-code4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── __post_init__: Add validation logic to dataclasses ────────────────────────\n",
    "@dataclass\n",
    "class PipelineJob:\n",
    "    name: str\n",
    "    parallelism: int\n",
    "    schedule_cron: str\n",
    "\n",
    "    def __post_init__(self):\n",
    "        if not self.name.strip():\n",
    "            raise ValueError(\"Job name cannot be empty\")\n",
    "        if not 1 <= self.parallelism <= 64:\n",
    "            raise ValueError(f\"Parallelism must be 1–64, got {self.parallelism}\")\n",
    "        print(f\"Job '{self.name}' validated ✓\")\n",
    "\n",
    "    def describe(self):\n",
    "        return f\"{self.name} runs {self.schedule_cron} with {self.parallelism} workers\"\n",
    "\n",
    "job = PipelineJob(name=\"daily_sales_etl\", parallelism=4, schedule_cron=\"0 2 * * *\")\n",
    "print(job.describe())\n",
    "\n",
    "try:\n",
    "    bad_job = PipelineJob(name=\"broken\", parallelism=100, schedule_cron=\"*\")\n",
    "except ValueError as e:\n",
    "    print(f\"Validation failed: {e}\")"
   ]
