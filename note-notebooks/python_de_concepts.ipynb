    "# ── islice: Take first N rows from a generator without loading all ────────────\n",
    "def infinite_ids():\n",
    "    n = 0\n",
    "    while True:\n",
    "        yield f\"ID-{n:05d}\"\n",
    "        n += 1\n",
    "\n",
    "# Only materialize the first 5 — safe even if the source is infinite\n",
    "sample = list(itertools.islice(infinite_ids(), 5))\n",
    "print(\"Sample IDs:\", sample)"
   ]
