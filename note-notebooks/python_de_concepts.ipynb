    "# ── multiprocessing: CPU-bound data transformation ────────────────────────────\n",
    "from multiprocessing import Pool\n",
    "import time\n",
    "\n",
    "def expensive_transform(chunk: list) -> dict:\n",
    "    \"\"\"Heavy CPU computation on a chunk of data.\"\"\"\n",
    "    return {\n",
    "        'sum': sum(x**2 for x in chunk),\n",
    "        'count': len(chunk),\n",
    "        'mean': sum(chunk) / len(chunk)\n",
    "    }\n",
    "\n",
    "# Split a large dataset into chunks\n",
    "full_data = list(range(1_000_000))\n",
    "chunk_size = len(full_data) // 4\n",
    "chunks = [full_data[i:i+chunk_size] for i in range(0, len(full_data), chunk_size)]\n",
    "\n",
    "print(f\"Processing {len(full_data):,} rows across {len(chunks)} processes...\")\n",
    "start = time.perf_counter()\n",
    "\n",
    "with Pool(processes=4) as pool:\n",
    "    results = pool.map(expensive_transform, chunks)\n",
    "\n",
    "elapsed = time.perf_counter() - start\n",
    "print(f\"Done in {elapsed:.3f}s\")\n",
    "print(f\"Total count: {sum(r['count'] for r in results):,}\")"
   ]
