    "# ── Dict unpacking for config merging ────────────────────────────────────────\n",
    "DEFAULT_CONFIG = {\n",
    "    'batch_size': 1000,\n",
    "    'max_retries': 3,\n",
    "    'timeout': 30,\n",
    "    'dry_run': False,\n",
    "    'log_level': 'INFO'\n",
    "}\n",
    "\n",
    "PROD_OVERRIDES = {\n",
    "    'batch_size': 5000,\n",
    "    'timeout': 60,\n",
    "    'log_level': 'WARNING'\n",
    "}\n",
    "\n",
    "DEV_OVERRIDES = {\n",
    "    'batch_size': 10,\n",
    "    'dry_run': True,\n",
    "    'log_level': 'DEBUG'\n",
    "}\n",
    "\n",
    "# Later keys override earlier ones — clean config cascade\n",
    "prod_config = {**DEFAULT_CONFIG, **PROD_OVERRIDES}\n",
    "dev_config  = {**DEFAULT_CONFIG, **DEV_OVERRIDES}\n",
    "\n",
    "print(\"PROD config:\", prod_config)\n",
    "print(\"DEV  config:\", dev_config)"
   ]
