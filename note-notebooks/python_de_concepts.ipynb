    "# ── Chunked Pandas reading — never load a huge CSV all at once ────────────────\n",
    "import pandas as pd, io\n",
    "\n",
    "# Simulate a large CSV\n",
    "large_csv = \"id,value,category\\n\" + \"\\n\".join(\n",
    "    f\"{i},{i*1.5},{'A' if i%2==0 else 'B'}\" for i in range(1, 10001)\n",
    ")\n",
    "\n",
    "total_rows = 0\n",
    "category_totals = {'A': 0.0, 'B': 0.0}\n",
    "\n",
    "# chunksize=1000 means only 1000 rows in memory at a time\n",
    "for chunk in pd.read_csv(io.StringIO(large_csv), chunksize=1000):\n",
    "    total_rows += len(chunk)\n",
    "    for cat, grp in chunk.groupby('category'):\n",
    "        category_totals[cat] += grp['value'].sum()\n",
    "\n",
    "print(f\"Processed {total_rows:,} rows in chunks\")\n",
    "for cat, total in category_totals.items():\n",
    "    print(f\"  Category {cat}: {total:,.1f}\")"
   ]
