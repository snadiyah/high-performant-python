    "# ── **kwargs: Build flexible pipeline runner ──────────────────────────────────\n",
    "def run_etl(source: str, destination: str, **options):\n",
    "    \"\"\"\n",
    "    Generic ETL runner. Accepts optional parameters:\n",
    "    - batch_size (int, default 1000)\n",
    "    - dry_run (bool, default False)\n",
    "    - max_retries (int, default 3)\n",
    "    - filters (dict, default {})\n",
    "    \"\"\"\n",
    "    batch_size  = options.get('batch_size', 1000)\n",
    "    dry_run     = options.get('dry_run', False)\n",
    "    max_retries = options.get('max_retries', 3)\n",
    "    filters     = options.get('filters', {})\n",
    "\n",
    "    prefix = '[DRY RUN]' if dry_run else '[LIVE]'\n",
    "    print(f\"{prefix} ETL: {source} → {destination}\")\n",
    "    print(f\"  batch_size={batch_size}, max_retries={max_retries}, filters={filters}\")\n",
    "    if options.get('unknown_param'):\n",
    "        print(f\"  Extra option: {options['unknown_param']}\")\n",
    "\n",
    "run_etl(\"postgres://prod/orders\", \"bigquery://dw/orders\")\n",
    "print()\n",
    "run_etl(\n",
    "    \"s3://bucket/data/\", \"snowflake://dw/raw\",\n",
    "    batch_size=5000,\n",
    "    dry_run=True,\n",
    "    filters={'date_gte': '2024-01-01'},\n",
    "    unknown_param=\"hello\"  # Gracefully handled\n",
    ")"
   ]
  },
