   "cell_type": "code",
   "execution_count": null,
   "id": "concept6-code2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Parameterized decorator: retry with exponential backoff ───────────────────\n",
    "import random\n",
    "\n",
    "def retry(max_attempts=3, delay=1.0, backoff=2.0, exceptions=(Exception,)):\n",
    "    \"\"\"Decorator factory — returns a decorator configured with the given params.\"\"\"\n",
    "    def decorator(fn):\n",
    "        @functools.wraps(fn)\n",
    "        def wrapper(*args, **kwargs):\n",
    "            wait = delay\n",
    "            for attempt in range(1, max_attempts + 1):\n",
    "                try:\n",
    "                    return fn(*args, **kwargs)\n",
    "                except exceptions as e:\n",
    "                    if attempt == max_attempts:\n",
    "                        log.error(f\"{fn.__name__} failed after {max_attempts} attempts\")\n",
    "                        raise\n",
    "                    log.warning(f\"{fn.__name__} attempt {attempt} failed: {e}. Retrying in {wait:.1f}s...\")\n",
    "                    time.sleep(wait)\n",
    "                    wait *= backoff   # Exponential backoff\n",
    "        return wrapper\n",
    "    return decorator\n",
    "\n",
    "# Simulate a flaky API endpoint\n",
    "call_count = 0\n",
    "\n",
    "@retry(max_attempts=3, delay=0.01, exceptions=(ConnectionError,))\n",
    "def call_flaky_api(endpoint: str) -> dict:\n",
    "    global call_count\n",
    "    call_count += 1\n",
    "    if call_count < 3:\n",
    "        raise ConnectionError(\"Transient network error\")\n",
    "    return {\"status\": \"ok\", \"data\": [1, 2, 3]}\n",
    "\n",
    "result = call_flaky_api(\"/orders\")\n",
    "print(f\"Succeeded after {call_count} attempt(s): {result}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "concept6-code3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Stacking decorators ───────────────────────────────────────────────────────\n",
    "# Decorators apply bottom-up: @timed wraps the already-retried function\n",
    "\n",
    "call_count2 = 0\n",
    "\n",
    "@timed\n",
    "@retry(max_attempts=3, delay=0.01)\n",
    "def fetch_orders(date: str) -> list:\n",
    "    global call_count2\n",
    "    call_count2 += 1\n",
    "    if call_count2 < 2:\n",
    "        raise TimeoutError(\"DB timeout\")\n",
    "    return [{'id': i, 'date': date} for i in range(5)]\n",
    "\n",
    "orders = fetch_orders(\"2024-01-15\")\n",
    "print(f\"Got {len(orders)} orders\")"
   ]
