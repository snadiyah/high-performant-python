   "source": [
    "import pandas as pd\n",
    "\n",
    "# ── Pandas dtype optimization: reduce memory by 70%+ ─────────────────────────\n",
    "# Pandas defaults to int64/float64 — often wasteful\n",
    "\n",
    "# Create a sample DataFrame mimicking a real table\n",
    "import numpy as np\n",
    "np.random.seed(42)\n",
    "\n",
    "n = 500_000\n",
    "df = pd.DataFrame({\n",
    "    'order_id':   np.random.randint(1, 1_000_000, n).astype('int64'),   # fits in int32\n",
    "    'customer_id':np.random.randint(1, 10_000, n).astype('int64'),      # fits in int16\n",
    "    'amount':     np.random.uniform(1, 500, n).astype('float64'),       # float32 is fine\n",
    "    'status':     np.random.choice(['pending','shipped','delivered'], n) # should be category\n",
    "})\n",
    "\n",
    "print(f\"Before optimization: {df.memory_usage(deep=True).sum() / 1e6:.2f} MB\")\n",
    "print(df.dtypes, \"\\n\")\n",
    "\n",
    "# Optimize dtypes\n",
    "df_opt = df.copy()\n",
    "df_opt['order_id']    = df_opt['order_id'].astype('int32')\n",
    "df_opt['customer_id'] = df_opt['customer_id'].astype('int16')\n",
    "df_opt['amount']      = df_opt['amount'].astype('float32')\n",
    "df_opt['status']      = df_opt['status'].astype('category')  # Huge win for low-cardinality strings\n",
    "\n",
    "after_mb  = df_opt.memory_usage(deep=True).sum() / 1e6\n",
    "before_mb = df.memory_usage(deep=True).sum() / 1e6\n",
    "\n",
    "print(f\"After optimization : {after_mb:.2f} MB\")\n",
    "print(f\"Reduction          : {(1 - after_mb/before_mb)*100:.1f}%\")"
   ]
  },
